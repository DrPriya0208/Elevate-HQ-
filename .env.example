# --- Database (Neon free tier) ---
# Neon dashboard > Connect. Use the POOLED string for DATABASE_URL
# and the DIRECT (non-pooled) string for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Admin login (one admin) ---
# AUTH_SECRET: run `openssl rand -base64 32`
AUTH_SECRET=""
ADMIN_EMAIL="admin@example.com"
# Run `npm run hash -- "your-strong-password"` and paste the output value here
ADMIN_PASSWORD_HASH_B64=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Photo uploads (blog cover images + in-post images), Cloudflare R2 ---
# Cloudflare > R2 > bucket "elevatehq-photos" with custom domain photos.elevatehqservices.com.
# Token: R2 > Manage API Tokens > Account API token, "Object Read & Write" on that bucket only.
# Without these, photo uploads are disabled.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="elevatehq-photos"
R2_PUBLIC_URL="https://photos.elevatehqservices.com"

# --- Contact form email (optional; enquiries are always saved to the database) ---
# Resend free tier. Until elevatehqservices.com is verified in Resend, leave
# CONTACT_FROM_EMAIL empty and set CONTACT_TO_EMAIL to your Resend account email.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""
