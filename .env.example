# --- Database (Neon free tier) ---
# Neon dashboard > Connect. Use the POOLED string for DATABASE_URL
# and the DIRECT (non-pooled) string for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Admin login (one admin) ---
# AUTH_SECRET: run `openssl rand -base64 32`
AUTH_SECRET=""
ADMIN_EMAIL="admin@example.com"
# Run `npm run hash -- "your-strong-password"` and paste the output value here
ADMIN_PASSWORD_HASH_B64=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Calendly or Cal.com link for the free introductory call. Leave empty to hide the booking card on /contact.
NEXT_PUBLIC_BOOKING_URL=""

# --- Photo uploads (blog cover images + in-post images), Cloudflare R2 ---
# Cloudflare > R2 > bucket "elevatehq-photos" with custom domain photos.elevatehqservices.com.
# Token: R2 > Manage API Tokens > Account API token, "Object Read & Write" on that bucket only.
# Without these, photo uploads are disabled.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="elevatehq-photos"
R2_PUBLIC_URL="https://photos.elevatehqservices.com"

# --- Spam and brute-force protection (each layer is off until its keys are set) ---
# Cloudflare Turnstile, the human check on the contact form, review form and admin login.
# Cloudflare dashboard > Turnstile > Add widget: hostnames elevatehqservices.com and
# www.elevatehqservices.com (plus the *.vercel.app address if used), mode "Managed".
# Put the real site key and secret key in Vercel only: Cloudflare does not allow localhost on a
# real widget. For local development use Cloudflare's test keys, which always pass:
#   1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Upstash Redis (free tier), rate limits: 5 enquiries and 3 reviews per hour per visitor,
# 10 login attempts per 15 minutes per visitor. console.upstash.com > Create database > REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Contact form email (optional; enquiries are always saved to the database) ---
# Resend free tier. Until elevatehqservices.com is verified in Resend, leave
# CONTACT_FROM_EMAIL empty and set CONTACT_TO_EMAIL to your Resend account email.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""
