generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    @db.Text
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Enquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  interest     String
  organisation String?
  message      String   @db.Text
  /// Name of the team member the visitor asked for, as it was when they wrote (null = no preference)
  preferredMember String?
  createdAt    DateTime @default(now())
}

/// Team members shown on /about (below the founders) and offered on the contact form.
/// Managed from /admin/team. Nothing shows on the site while no member is active.
model TeamMember {
  id             String   @id @default(cuid())
  name           String
  role           String
  bio            String   @db.Text
  /// One qualification or certification per line
  qualifications String   @default("") @db.Text
  languages      String?
  linkedin       String?
  photo          String?
  /// Lower numbers show first
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, sortOrder])
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model Review {
  id         String       @id @default(cuid())
  name       String       @default("Anonymous")
  rating     Int
  message    String       @db.Text
  status     ReviewStatus @default(PENDING)
  featured   Boolean      @default(false)
  consent    Boolean
  createdAt  DateTime     @default(now())
  approvedAt DateTime?
  updatedAt  DateTime     @updatedAt

  @@index([status, approvedAt])
}
